<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Giriş · Yemekhane</title>
  <link rel="stylesheet" href="/css/temel.css">
  <link rel="stylesheet" href="/css/uygulama.css">
</head>
<body>
  <main class="kutu">
    <h1>Yemekhane Otomasyonu</h1>
    <% if (hata) { %><p class="hata"><%= hata %></p><% } %>
    <form method="post" action="/giris">
      <label for="eposta">E-posta</label>
      <input id="eposta" name="eposta" type="email" value="<%= eposta %>" required autofocus>
      <label for="sifre">Şifre</label>
      <input id="sifre" name="sifre" type="password" required>
      <button type="submit">Giriş yap</button>
    </form>
  </main>
</body>
</html>