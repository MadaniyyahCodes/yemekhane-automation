<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Değerlendirme · Yemekhane</title>
  <link rel="stylesheet" href="/css/temel.css">
  <link rel="stylesheet" href="/css/uygulama.css">
</head>
<body>
  <%- include('partials/ust') %>
  <main class="kutu genis">
    <h1>Menü değerlendirme</h1>
    <p>Yalnızca kullandığınız menüleri 1 ile 5 arasında puanlayabilirsiniz.</p>

    <% if (hata) { %><p class="hata"><%= hata %></p><% } %>
    <% if (basari) { %><p class="basari"><%= basari %></p><% } %>

    <% if (menuler.length === 0) { %>
      <p>Henüz kullandığınız bir menü yok.</p>
    <% } %>

    <% menuler.forEach(function (m) { %>
      <article class="kart">
        <div><strong><%= m.yemekhane %></strong> · <%= m.ogun %></div>
        <p class="kart-bilgi"><%= m.tarihAdi %></p>

        <% if (m.degerlendirildi) { %>
          <p class="yildiz"><%= '★'.repeat(m.puan) + '☆'.repeat(5 - m.puan) %> (<%= m.puan %>/5)</p>
          <% if (m.yorum) { %><p>“<%= m.yorum %>”</p><% } %>
        <% } else { %>
          <form method="post" action="/degerlendirme">
            <input type="hidden" name="menu_id" value="<%= m.menu_id %>">
            <label for="puan-<%= m.menu_id %>">Puan</label>
            <select id="puan-<%= m.menu_id %>" name="puan" required>
              <option value="">Seçin</option>
              <option value="5">5 – Çok iyi</option>
              <option value="4">4 – İyi</option>
              <option value="3">3 – Orta</option>
              <option value="2">2 – Zayıf</option>
              <option value="1">1 – Çok kötü</option>
            </select>
            <label for="yorum-<%= m.menu_id %>">Yorum (isteğe bağlı)</label>
            <textarea id="yorum-<%= m.menu_id %>" name="yorum" maxlength="500" rows="3"></textarea>
            <button type="submit">Değerlendir</button>
          </form>
        <% } %>
      </article>
    <% }); %>
  </main>
</body>
</html>