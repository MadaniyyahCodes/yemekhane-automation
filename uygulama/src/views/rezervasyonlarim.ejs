<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Rezervasyonlarım · Yemekhane</title>
  <link rel="stylesheet" href="/css/temel.css">
  <link rel="stylesheet" href="/css/uygulama.css">
</head>
<body>
  <%- include('partials/ust') %>
  <main class="kutu genis">
    <h1>Rezervasyonlarım</h1>
    <p>Güncel bakiye: <strong><%= Number(bakiye).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) %> TL</strong></p>

    <% if (hata) { %><p class="hata"><%= hata %></p><% } %>
    <% if (basari) { %><p class="basari"><%= basari %></p><% } %>

    <% if (rezervasyonlar.length === 0) { %>
      <p>Henüz rezervasyonunuz yok.</p>
    <% } %>

    <% rezervasyonlar.forEach(function (r) { %>
      <article class="kart">
        <div><strong><%= r.yemekhane %></strong> · <%= r.ogun %></div>
        <p class="kart-bilgi">
          <%= r.tarihAdi %>
         <% if (r.sonSaat) { %>· Son saat: <%= r.sonSaat %><% } %>
          · <%= r.porsiyon === 'yarim' ? 'Yarım porsiyon' : 'Tam porsiyon' %>
        </p>

        <% if (r.durum === 'aktif') { %>
          <span class="etiket vej"><%= r.durumEtiketi %></span>
          <% if (r.sureDoldu) { %>
            <button type="button" disabled>İptal süresi doldu</button>
          <% } else { %>
            <form method="post" action="/rezervasyon/iptal">
              <input type="hidden" name="rezervasyon_id" value="<%= r.id %>">
              <button type="submit" class="ikincil">Rezervasyonu iptal et</button>
            </form>
          <% } %>
        <% } else if (r.durum === 'iptal') { %>
          <span class="etiket iptal"><%= r.durumEtiketi %></span>
        <% } else { %>
          <span class="etiket gri"><%= r.durumEtiketi %></span>
        <% } %>
      </article>
    <% }); %>
  </main>
</body>
</html>